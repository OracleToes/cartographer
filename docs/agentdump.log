      for(let i=0;i<n;i++) ctx.lineTo(this.points[i].x,this.points[i].y);
      for(let j=0;j<n;j++) ctx.lineTo(this.points[j*n+n-1].x,this.points[j*n+n-1].y);
      for(let i=n-1;i>=0;i--) ctx.lineTo(this.points[(n-1)*n+i].x,this.points[(n-1)*n+i].y);
      for(let j=n-1;j>=0;j--) ctx.lineTo(this.points[j*n].x,this.points[j*n].y);
      ctx.closePath();
      ctx.fillStyle='#2b2740';
      ctx.fill();
      ctx.lineWidth=3; ctx.strokeStyle='#e8e4d8'; ctx.stroke();
      // face numbers on each edge
      const labels=['1','2','3','4'];
      const edges=[
        [0,n-1],[n-1,(n-1)*n+n-1],[(n-1)*n,(n-1)*n+n-1],[0,(n-1)*n]
      ];
      ctx.font='bold 22px ui-monospace, monospace';
      ctx.textAlign='center'; ctx.textBaseline='middle';
      for(let e=0;e<4;e++){
        const [ai,bi]=edges[e];
        const a=this.points[ai], b=this.points[bi];
        const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
        const vx=b.x-a.x, vy=b.y-a.y, len=Math.hypot(vx,vy)||1;
