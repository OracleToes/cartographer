            const vx=p.x-p.px;
            if(vx<0) p.px=p.x-vx*-0.45; // reflect with restitution
            else p.px=p.x;
          }
          if(p.x>W-r){
            p.x=W-r;
            const vx=p.x-p.px;
            if(vx>0) p.px=p.x-vx*-0.45;
            else p.px=p.x;
          }
        }
      }
      // shape matching: pull vertices toward rest shape (best-fit rigid pose)
      {
        let cx=0, cy=0;
        for(const p of this.points){cx+=p.x;cy+=p.y;}
        cx/=this.points.length; cy/=this.points.length;
        const n=this.n;
        const tl=this.points[0], br=this.points[(n-1)*n+(n-1)];
        const ang=Math.atan2(br.y-tl.y, br.x-tl.x)-Math.PI/4;
        const cos=Math.cos(ang), sin=Math.sin(ang);
        const rest=this.restLocal;
        for(let i=0;i<this.points.length;i++){
          const p=this.points[i], r=rest[i];
          const tx=cx + r.x*cos - r.y*sin;
          const ty=cy + r.x*sin + r.y*cos;
          p.x += (tx-p.x)*0.18;
          p.y += (ty-p.y)*0.18;
        }
      }
      // compute center & angle from edge midpoints
      this.computePose();
      // settle detection
      let maxV=0;
      for(const p of this.points){
        const v=Math.hypot(p.x-p.px,p.y-p.py);
        if(v>maxV) maxV=v;
      }
      if(maxV<0.35){ this.restTimer++; if(this.restTimer>25) this.settle(); }
      else this.restTimer=0;
    }
    computePose(){
      let cx=0, cy=0;
      for(const p of this.points){cx+=p.x;cy+=p.y;}
      cx/=this.points.length; cy/=this.points.length;
      this.cx=cx; this.cy=cy;
      const n=this.n;
      const top=this.points[0], right=this.points[n-1], bottom=this.points[(n-1)*n+n-1];
      // angle from top-left->bottom-right diagonal
      const tl=this.points[0], br=this.points[(n-1)*n+(n-1)];
      this.angle=Math.atan2(br.y-tl.y, br.x-tl.x) - Math.PI/4;
    }
    settle(){
      if(this.settled) return;
      this.settled=true;
      // face = which edge is up
      const a=this.angle;
      // edges: 0 top,1 right,2 bottom,3 left — normalize angle
      let deg=((a*180/Math.PI)%360+360)%360;
      // face up = edge whose outward normal points up
      // edges labeled 1..4 clockwise from top
      let f=Math.round(((deg%90)/90)); // rough
      // better: compute normal of each edge and pick the one pointing up
      const n=this.n;
      const edges=[
        [this.points[0], this.points[n-1]],
        [this.points[n-1], this.points[(n-1)*n+n-1]],
        [this.points[(n-1)*n], this.points[(n-1)*n+n-1]],
        [this.points[0], this.points[(n-1)*n]]
      ];
      let best=0, bestDot=-Infinity;
      for(let e=0;e<4;e++){
        const [p,q]=edges[e];
        let dx=q.x-p.x, dy=q.y-p.y;
        const len=Math.hypot(dx,dy)||1;
        // outward normal (rotate edge direction by -90 for cw edges?) — use perpendicular pointing away from center
        const nx=-dy/len, ny=dx/len;
        const mx=(p.x+q.x)/2-this.cx, my=(p.y+q.y)/2-this.cy;
        const dot=nx*mx+ny*my;
        const outward=(dot>0)?[nx,ny]:[-nx,-ny];
        const up=-outward[1]; // positive = pointing up
        if(up>bestDot){bestDot=up;best=e;}
      }
      this.face=best+1;
      resultEl.innerHTML=this.face+'<small>FACE UP</small>';
      resultEl.classList.add('show');
    }
    reset(){
      // rebuild in place, unsettled
      const {cx,cy}=this;
